# =============================================================================
# agent-live-web environment configuration
# Copy this file to .env and fill in values for your setup.
# =============================================================================

# --- Model Provider (Python agent) ------------------------------------------
# Choose: openai | azure | auto (auto prefers openai when OPENAI_API_KEY is set)
AGENT_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o

# Azure OpenAI (used when AGENT_PROVIDER=azure or auto-fallback)
# azure_key=
# azure_endpoint_uri=
# azure_deployment_name=gpt-4o
# azure_api_version=2024-12-01-preview

# --- Python Agent Behavior --------------------------------------------------
AGENT_MAX_ITERATIONS=10
AGENT_TOOL_TIMEOUT_SEC=180
AGENT_MAX_HISTORY_MESSAGES=60

# Memory
AGENT_MEMORY_AUTO_LOG=false
AGENT_MEMORY_AUTO_RECALL=true
AGENT_MEMORY_RECALL_TOP_K=4
AGENT_MEMORY_RECALL_DAYS_BACK=30
AGENT_PRIVATE_SESSION=true

# Session state
AGENT_SESSION_STATE_ENABLED=true
# AGENT_SESSION_STATE_FILE=.agent-state/last_session.json

# Command execution security (restricted | permissive)
AGENT_RUN_COMMAND_SECURITY_MODE=restricted

# --- Edge Session (JS browser control) --------------------------------------
# EDGE_USER_DATA_DIR=.playwright-edge-profile
# EDGE_WORKSPACE_ROOT=.
EDGE_LOCAL_OPERATOR_MODE=true
EDGE_RESTRICT_WRITE_TO_WORKSPACE=true
EDGE_ALLOW_DOM_HTML_ADD=false
EDGE_ALLOW_DOM_DELETE=false
EDGE_DOM_FALLBACK_ON_FAILURE=true
EDGE_FRAME_AWARE_LOCATORS=true
EDGE_ACTION_TIMEOUT_MS=30000
EDGE_NAV_TIMEOUT_MS=180000
EDGE_ACTION_RETRIES=2

# Logging
EDGE_WRITE_LOG_FILE=false
EDGE_LOG_TO_CONSOLE=false
EDGE_LOG_ACTION_PAYLOADS=false

# --- Playwright MCP Server --------------------------------------------------
PLAYWRIGHT_MCP_OWNER=vscode
PLAYWRIGHT_MCP_FORCE_OWNER=true
PLAYWRIGHT_MCP_PERSIST_PROFILE=true
PLAYWRIGHT_MCP_SAVE_SESSION=false
PLAYWRIGHT_MCP_SAVE_TRACE=false
PLAYWRIGHT_MCP_OUTPUT_MODE=stdout
PLAYWRIGHT_MCP_SNAPSHOT_MODE=incremental
PLAYWRIGHT_MCP_CONSOLE_LEVEL=error
PLAYWRIGHT_MCP_TIMEOUT_ACTION_MS=18000
PLAYWRIGHT_MCP_TIMEOUT_NAVIGATION_MS=90000
PLAYWRIGHT_MCP_SHARED_BROWSER_CONTEXT=true
PLAYWRIGHT_MCP_BLOCK_SERVICE_WORKERS=false
PLAYWRIGHT_MCP_BLOCKED_ORIGINS=http://127.0.0.1;http://localhost;http://[::1];https://127.0.0.1;https://localhost;https://[::1];http://169.254.169.254;http://169.254.170.2

# Local profile and output paths (relative to repo root via .vscode/mcp.json)
PLAYWRIGHT_MCP_USER_DATA_DIR=.playwright-mcp/edge-profile
PLAYWRIGHT_MCP_OUTPUT_DIR=.playwright-mcp/output
# PLAYWRIGHT_MCP_OWNER_FILE=.playwright-mcp/active-owner.txt

# CDP endpoint (leave empty to use local Edge profile)
# PLAYWRIGHT_MCP_CDP_ENDPOINT=

# Network restrictions
# PLAYWRIGHT_MCP_ALLOWED_HOSTS=
# PLAYWRIGHT_MCP_ALLOWED_ORIGINS=

# --- Tracing (OpenTelemetry) ------------------------------------------------
EDGE_TRACING_ENABLED=false
EDGE_TRACING_SERVICE_NAME=agent-live-web-vscode-mcp
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
