# Agent Live Web example environment file
# Copy to `.env` and fill only the provider block you actually use.

# ----------------------------
# Provider selection
# ----------------------------
# Valid values: auto | openai | azure
AGENT_PROVIDER=auto

# Optional explicit model name
# OpenAI example: codex-5.3
# Azure example: your deployment/model alias
AGENT_MODEL=codex-5.3

# ----------------------------
# OpenAI / Codex-style setup
# ----------------------------
OPENAI_API_KEY=
# Optional alternate model env if you prefer it
OPENAI_MODEL=

# ----------------------------
# Azure-style setup
# ----------------------------
azure_key=
azure_endpoint_uri=
azure_deployment_name=
azure_api_version=2024-12-01-preview

# ----------------------------
# Python agent behavior
# ----------------------------
AGENT_FAST_MODE=true
AGENT_MAX_ITERATIONS=7
AGENT_TOOL_TIMEOUT_SEC=90
AGENT_MEMORY_AUTO_LOG=false
AGENT_MEMORY_AUTO_RECALL=true
AGENT_PRIVATE_SESSION=true
AGENT_SESSION_STATE_ENABLED=true

# ----------------------------
# MCP / browser runtime
# ----------------------------
PLAYWRIGHT_MCP_HEADLESS=true
AGENT_MCP_CONNECT_TIMEOUT_SEC=60
AGENT_MCP_TOOL_TIMEOUT_SEC=45
AGENT_MCP_SHUTDOWN_TIMEOUT_SEC=15

# ----------------------------
# Safety defaults
# ----------------------------
AGENT_RUN_COMMAND_SECURITY_MODE=restricted
