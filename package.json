{
  "name": "agent-works",
  "version": "5.1.0",
  "description": "Local-first developer agent for repo, terminal, editor, and browser workflows with MCP-backed automation, safety gating, and verification.",
  "scripts": {
    "agent:python": "python agent/agent/agent.py",
    "agent:preflight": "python agent/agent/agent.py --preflight",
    "agent:mcp-status": "python agent/agent/agent.py --mcp-status",
    "agent:mcp-status:json": "python agent/agent/agent.py --mcp-status --json",
    "agent:live-web": "node cli-agent.js",
    "agent:vscode": "node scripts/set-mcp-owner.js vscode && node playwright-edge-mcp.js",
    "mcp:edge": "node scripts/set-mcp-owner.js vscode && node playwright-edge-mcp.js",
    "mcp:probe": "node scripts/mcp-raw-probe.js",
    "mcp:owner:vscode": "node scripts/set-mcp-owner.js vscode",
    "trace:jaeger:start": "node scripts/trace-stack-control.js jaeger start",
    "trace:jaeger:stop": "node scripts/trace-stack-control.js jaeger stop",
    "trace:collector:start": "node scripts/trace-stack-control.js collector start",
    "trace:collector:stop": "node scripts/trace-stack-control.js collector stop",
    "trace:stack:start": "node scripts/trace-stack-control.js stack start",
    "trace:stack:stop": "node scripts/trace-stack-control.js stack stop",
    "trace:check": "node scripts/check-tracing.js",
    "trace:latest": "node scripts/trace-latest.js",
    "trace:latest:errors": "node scripts/trace-latest-profile.js errors",
    "trace:incident": "node scripts/trace-latest-profile.js incident",
    "trace:triage": "node scripts/trace-triage.js",
    "eval:dataset": "node scripts/eval/generate-dataset.js --profile=baseline",
    "eval:dataset:stress": "node scripts/eval/generate-dataset.js --profile=stress --force",
    "eval:dataset:failure": "node scripts/eval/generate-dataset.js --profile=failure --force",
    "eval:collect": "node scripts/eval/collect-responses.js",
    "eval:run": "node scripts/eval/run-evaluation.js",
    "eval:history": "node scripts/eval/update-history.js",
    "eval:gate": "node scripts/eval/ci-gate.js",
    "eval:gate:lenient": "node scripts/eval-gate-profile.js lenient",
    "eval:gate:normal": "node scripts/eval-gate-profile.js normal",
    "eval:gate:strict": "node scripts/eval-gate-profile.js strict",
    "eval:flake": "node scripts/eval/run-flake-check.js",
    "eval:all": "npm run eval:dataset && npm run eval:collect && npm run eval:run && npm run eval:history",
    "eval:all:stress": "npm run eval:dataset:stress && npm run eval:collect && npm run eval:run && npm run eval:history",
    "eval:all:failure": "npm run eval:dataset:failure && npm run eval:collect && npm run eval:run && npm run eval:history",
    "eval:ci": "npm run eval:all:stress && npm run eval:gate",
    "eval:ci:strict": "npm run eval:all:stress && npm run eval:gate:strict && npm run eval:flake",
    "playwright:edge:smoke": "node scripts/playwright-edge-smoke.js",
    "trace:playwright:smoke": "node scripts/trace-playwright-smoke.js",
    "health:snapshot": "node scripts/health-snapshot.js",
    "health:snapshot:quiet": "node scripts/health-snapshot.js --quiet",
    "install:edge": "npx playwright install msedge",
    "check": "node --check browser-safety.js && node --check mcp-jsonrpc-transport.js && node --check mcp-safety-adapter.js && node --check cli-agent.js && node --check edge-session.js && node --check nl-command-parser.js && node --check playwright-edge-mcp.js && node --check playwright-mcp-launch-config.js && node --check scripts/mcp-init-page.js && node --check scripts/mcp-raw-probe.js",
    "test:unit": "node tests/edge-session-safety.test.js && node tests/mcp-jsonrpc-transport.test.js && node tests/playwright-edge-mcp-safety.test.js && node tests/playwright-mcp-launch-config.test.js",
    "agent:test:py": "python -m unittest discover -s agent/agent/tests -p \"test_*.py\" -v",
    "agent:test:py:integration": "python -m unittest discover -s agent/agent/tests/integration -p \"test_*.py\" -v",
    "verify": "npm run check && npm run test:unit && npm run agent:test:py",
    "test": "npm run verify"
  },
  "keywords": [
    "playwright",
    "mcp",
    "ai-agent",
    "developer-agent",
    "vscode",
    "edge",
    "browser-automation",
    "web-automation",
    "local-first",
    "verification",
    "safety",
    "opentelemetry",
    "tracing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.70.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "playwright": "^1.58.2"
  }
}
